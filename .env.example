# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rdcredit?schema=public"

# Backend Server
PORT=3000
NODE_ENV=development

# ShareFile OAuth
SHAREFILE_CLIENT_ID=your_client_id_here
SHAREFILE_CLIENT_SECRET=your_client_secret_here
SHAREFILE_REDIRECT_URI=http://localhost:3000/api/auth/sharefile/callback
SHAREFILE_SUBDOMAIN=your_subdomain
SHAREFILE_API_URL=https://your_subdomain.sharefile.com/sf/v3

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api
