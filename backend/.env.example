# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3001
API_URL=https://your-domain.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/rdcredit?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ===========================================
# SHAREFILE OAUTH CONFIGURATION
# ===========================================
SHAREFILE_CLIENT_ID=your_client_id_here
SHAREFILE_CLIENT_SECRET=your_client_secret_here
SHAREFILE_REDIRECT_URI=https://your-domain.com/api/auth/sharefile/callback
SHAREFILE_SUBDOMAIN=your_subdomain
SHAREFILE_API_URL=https://your_subdomain.sharefile.com/sf/v3
SHAREFILE_TOKEN_ENDPOINT=https://secure.sharefile.com/oauth/token
SHAREFILE_AUTHORIZE_ENDPOINT=https://secure.sharefile.com/oauth/authorize

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET=your_jwt_secret_here_min_32_characters_CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ===========================================
# OPENAI CONFIGURATION
# ===========================================
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_MS=30000

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
CORS_CREDENTIALS=true
SESSION_SECRET=your_session_secret_here_CHANGE_THIS_IN_PRODUCTION

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=https://your-domain.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
MAX_DOCUMENT_SIZE=10485760
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.gif

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
LOG_COMPRESS=true

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@rdcredit.com
SMTP_FROM_NAME=R&D Credit Service

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ===========================================
# MONITORING & ERROR TRACKING (Optional)
# ===========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_DOCUMENT_MANAGEMENT=true
ENABLE_LLM_ASSISTANCE=true
ENABLE_PAYROLL_INTEGRATION=false
ENABLE_AUDIT_LOGGING=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SWAGGER_DOCS=false

# ===========================================
# PERFORMANCE & CACHING
# ===========================================
ENABLE_CACHE=true
CACHE_TTL=300
COMPRESSION_ENABLED=true
TRUST_PROXY=true
