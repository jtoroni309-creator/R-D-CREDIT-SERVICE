# ===========================================
# API CONFIGURATION
# ===========================================
VITE_API_URL=https://your-domain.com/api
VITE_API_TIMEOUT=30000

# ===========================================
# SHAREFILE CONFIGURATION
# ===========================================
VITE_SHAREFILE_CLIENT_ID=your_client_id_here
VITE_SHAREFILE_REDIRECT_URI=https://your-domain.com/auth/callback
VITE_SHAREFILE_SUBDOMAIN=your_subdomain
VITE_SHAREFILE_AUTHORIZE_URL=https://secure.sharefile.com/oauth/authorize

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
VITE_APP_NAME=R&D Tax Credit Service
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# ===========================================
# FEATURE FLAGS
# ===========================================
VITE_ENABLE_DOCUMENT_MANAGEMENT=true
VITE_ENABLE_LLM_ASSISTANCE=true
VITE_ENABLE_PAYROLL_INTEGRATION=false
VITE_ENABLE_ANALYTICS=false

# ===========================================
# UI CONFIGURATION
# ===========================================
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_CURRENCY=USD
VITE_MAX_UPLOAD_SIZE_MB=10
VITE_ITEMS_PER_PAGE=25

# ===========================================
# ANALYTICS (Optional)
# ===========================================
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
